# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
# Default connects to local MongoDB replica set
MONGODB_URI=mongodb://127.0.0.1:27017/job_feed_service?replicaSet=rs0&directConnection=true

# Worker Configuration
WORKER_ENABLED=false
WORKER_CONCURRENCY=2
POLL_INTERVAL_MS=500
LOCK_TIMEOUT_MS=30000
MAX_ATTEMPTS=3
BACKOFF_BASE_MS=1000

# Provider Verification Plan Path
PROVIDER_PLAN_PATH=fixtures/provider-plan.json
